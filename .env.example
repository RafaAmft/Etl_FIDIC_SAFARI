# ============================================================
# FIDC ETL — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# O arquivo .env NÃO deve ser versionado (está no .gitignore).
# ============================================================

# --- API B3 ---
# B3_URL_BUSCA=https://fnet.bmfbovespa.com.br/fnet/publico/pesquisarGerenciadorDocumentosDados
# B3_URL_DOWNLOAD=https://fnet.bmfbovespa.com.br/fnet/publico/downloadDocumento
# B3_TIMEOUT_BUSCA=10
# B3_TIMEOUT_DOWNLOAD=20
# B3_MAX_RETRIES=3
# B3_DELAY_REQUISICOES=2.0
# B3_USER_AGENT=Mozilla/5.0 (ETL FIDC Monitor v8)

# --- ETL Pipeline ---
# ETL_MAX_WORKERS=5
# ETL_ROLLING_WINDOW_MONTHS=60
# ETL_CACHE_ENABLED=true
# ETL_CACHE_VERSION=v8.0

# --- Filtros de negócio ---
# ETL_NPL_MIN=15.0
# ETL_NPL_MAX=150.0
# ETL_ATIVO_MIN=1000000.0
# ETL_SCORE_MIN=30.0

# --- Logging ---
# LOG_LEVEL=INFO
